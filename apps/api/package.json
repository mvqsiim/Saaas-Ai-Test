{
  "name": "@saas-ai-test/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "prisma:generate": "pnpm --filter @saas-ai-test/database prisma:generate"
  },
  "dependencies": {
    "@saas-ai-test/database": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.28",
    "ts-node-dev": "^2.0.0",
    "typescript": "workspace:^",
    "eslint": "workspace:^",
    "prettier": "workspace:^"
  }
}
